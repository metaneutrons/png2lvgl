# Muster bewusst UNVERANKERT, damit sie auf jeder Ebene greifen.
# Ein führender Slash würde bei einem neuen Unterprojekt nicht mehr passen.

target/
**/*.rs.bk
*.pdb

# Coverage
lcov.info
coverage/
*.profraw

# Node, falls irgendwo ein Unterprojekt entsteht
node_modules/
dist/
.pnpm-store/

# Umgebung und Zustand
.env
.env.*
!.env.example
*.log

# Editor und Betriebssystem
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Project specific
# png2lvgl erzeugt C-Dateien und liest PNGs; beides gehoert nicht ins Repo.
*.c
*.png
.amazonq
